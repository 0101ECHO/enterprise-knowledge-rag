# ============================================================
# 企业级知识库 RAG 系统 - 环境变量配置
# 复制此文件为 .env 并填写实际值
# ============================================================

# --- 应用配置 ---
APP_NAME=企业级知识库RAG
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# --- JWT 鉴权 ---
JWT_SECRET_KEY=请替换为你的密钥_至少32位随机字符串_使用openssl_rand_-hex_32生成
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL 数据库 ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragdb
DATABASE_URL=postgresql+psycopg2://raguser:ragpassword@postgres:5432/ragdb

# --- Redis 缓存/消息队列 ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Qdrant 向量数据库 ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=rag_

# --- DeepSeek LLM ---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_MAX_TOKENS=4096

# --- Embedding 模型 (BAAI/bge-m3) ---
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_DEVICE=cpu
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
HF_ENDPOINT=https://hf-mirror.com

# --- 文档处理 ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./data/uploads

# --- RAG 检索 ---
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.5
RERANK_ENABLED=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_MAX_LENGTH=512
RERANK_TOP_K=5

# --- OCR ---
OCR_ENABLED=true
OCR_LANG=ch

# --- 日志 ---
LOG_LEVEL=INFO
LOG_DIR=./data/logs
